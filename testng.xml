<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Flight Reservation Suite">
    <test name="Reservation Test Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.FlightReservationTest"/>
        </classes>
    </test>

    <test name="Reservation Test Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.FlightReservationTest"/>
        </classes>
    </test>

    <test name="Reservation Test Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.FlightReservationTest"/>
        </classes>
    </test>
</suite>
